{$COMMERCIAL_DOMAIN} {
	handle_path /brand* {
		root * /srv/brand
		file_server
	}
	handle_path /docs* {
		root * /srv/docs
		file_server
	}
	handle {
		reverse_proxy new-api:3000
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
		}
	}
}
