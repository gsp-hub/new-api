# deploy/commercial/.env — 复制为 .env 并填值后 docker compose up -d
# 强随机值生成：openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32
PG_USER=newapi
PG_PASSWORD=change-me
PG_DB=newapi

# Caddy 用（Caddyfile 里 {$COMMERCIAL_DOMAIN}）：商业域名
COMMERCIAL_DOMAIN=example.com

# HTTPS 上线时：SESSION_COOKIE_SECURE=true（compose 默认）必须同时提供受信站点地址
# 内网 HTTP 原型：compose 里改 SESSION_COOKIE_SECURE=false 即可
SESSION_COOKIE_TRUSTED_URL=https://your-domain
